 impl Collection {
+    /// The existing queue chooses today's new/review cards and excludes siblings.
+    /// Include already-scheduled intraday steps later today without simulating answers.
+    pub(crate) fn remaining_preview_ids(&mut self) -> Result<Vec<CardId>> {
+        let queues = self.get_queues()?;
+        let mut seen = std::collections::HashSet::new();
+        Ok(queues
+            .iter()
+            .map(|entry| entry.card_id())
+            .chain(queues.intraday_learning.iter().map(|entry| entry.id))
+            .filter(|id| seen.insert(*id))
+            .collect())
+    }
+
     pub fn get_next_card(&mut self) -> Result<Option<QueuedCard>> {
         self.get_queued_cards(1, false)
             .map(|queued| queued.cards.first().cloned())
