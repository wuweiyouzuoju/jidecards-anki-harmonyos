+#[cfg(feature = "rustls")]
+fn compact_import_log(log: &mut NoteLog) {
+    for note in log
+        .new
+        .iter_mut()
+        .chain(log.updated.iter_mut())
+        .chain(log.duplicate.iter_mut())
+        .chain(log.conflicting.iter_mut())
+        .chain(log.first_field_match.iter_mut())
+        .chain(log.missing_notetype.iter_mut())
+        .chain(log.missing_deck.iter_mut())
+        .chain(log.empty_first_field.iter_mut())
+    {
+        note.fields.clear();
+    }
+}
