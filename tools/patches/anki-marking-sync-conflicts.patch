+                .or_invalid("pending card missing")?;
+            card.mtime = TimestampSecs(
+                card.mtime
+                    .max(now)
+                    .0
+                    .checked_add(1)
+                    .or_invalid("card sync revision overflow")?,
+            );
+            self.storage.update_card(&card)?;
