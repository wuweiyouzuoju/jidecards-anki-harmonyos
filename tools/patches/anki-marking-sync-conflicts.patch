+    fn prepare_marking_sync_revisions(&self, pending_usn: Usn) -> Result<()> {
+        if !self.state.marking_sync_priority {
+            return Ok(());
+        }
+        // SetFlag deliberately leaves mtime unchanged. An unmodified peer/server
+        // requires strictly newer revisions to accept pending marker changes.
+        // With no per-field history, every remaining pending row needs a revision.
+        // This runs inside the normal sync transaction, after queues are cleared.
