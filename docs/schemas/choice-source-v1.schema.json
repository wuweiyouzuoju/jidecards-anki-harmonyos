{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jidecards:choice:source:v1",
  "title": "JideCards choice APKG source v1",
  "description": "Authoring source only. Deliver standard APKG. Run the CLI validator for ID references and byte limits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "title", "questions"],
  "properties": {
    "format": {"const": "jidecards.choice"},
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "feedbackSeconds": {"type": "integer", "minimum": 0, "maximum": 60, "default": 5},
    "questions": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "option": {
      "type": "object", "additionalProperties": false, "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "text": {"type": "string", "minLength": 1, "maxLength": 10000}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "prompt", "options", "answer"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 120},
        "type": {"enum": ["single_choice", "multiple_choice"]},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 20000},
        "options": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"$ref": "#/$defs/option"}},
        "answer": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "explanation": {"type": "string", "maxLength": 20000, "default": ""}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "single_choice"}}}, "then": {"properties": {"answer": {"maxItems": 1}}}},
        {"if": {"properties": {"type": {"const": "multiple_choice"}}}, "then": {"properties": {"answer": {"minItems": 2}}}}
      ]
    }
  }
}
