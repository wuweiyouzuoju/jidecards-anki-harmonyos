# Native bridge 声明文件强制 LF 行尾
# 防止 core.autocrlf=true 在 git restore 时把 LF 转为 CRLF，
# 导致 native-bridge-contract.test.mjs 契约测试（两份 oh-package.json5 严格相等比较）失败
native/napi_bridge/oh-package.json5 text eol=lf
native/napi_bridge/index.d.ts text eol=lf
entry/src/main/cpp/types/libjidecards/oh-package.json5 text eol=lf
entry/src/main/cpp/types/libjidecards/index.d.ts text eol=lf

# 保留上游资源字节，避免 Windows checkout 改行尾后破坏 manifest 校验。
entry/src/main/resources/rawfile/mathjax/tex-svg-full.js -text
entry/src/main/resources/rawfile/mathjax/input/** -text
entry/src/main/resources/rawfile/mathjax/LICENSE -text

# jQuery 的上游哈希也依赖原始 LF 字节；不要随 Windows checkout 改写。
entry/src/main/resources/rawfile/jquery/jquery-3.7.1.min.js -text

# Official manual bytes, section offsets and attribution must survive checkout unchanged.
entry/src/main/resources/rawfile/anki-manual/** -text

# Sandbox source and engine hashes must survive checkout unchanged.
native/agent-sandbox/guest.c text eol=lf
native/agent-sandbox/engine/*.wasm -text
native/agent-sandbox/Cargo.lock text eol=lf
entry/src/main/resources/rawfile/agent-sandbox-notices.txt -text

# Unified patches use a leading space for unchanged blank context lines.
tools/patches/*.patch whitespace=-blank-at-eol
