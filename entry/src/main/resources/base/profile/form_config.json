{
  "forms": [
    {
      "name": "stats_card",
      "displayName": "$string:stats_card_name",
      "description": "$string:stats_card_desc",
      "src": "./ets/widget/pages/统计卡片.ets",
      "uiSyntax": "arkts",
      "window": {
        "designWidth": 720,
        "autoDesignWidth": true
      },
      "colorMode": "auto",
      "isDefault": true,
      "updateEnabled": true,
      "updateDuration": 1,
      "defaultDimension": "2*4",
      "supportDimensions": ["2*4"],
      "formConfigAbility": "ability://EntryAbility",
      "standby": {
        "isSupported": false
      }
    },
    {
      "name": "today_review_card",
      "displayName": "$string:today_review_widget_name",
      "description": "$string:today_review_widget_description",
      "src": "./ets/widget/pages/TodayReviewCard.ets",
      "uiSyntax": "arkts",
      "renderingMode": "fullColor",
      "isDefault": false,
      "updateEnabled": true,
      "updateDuration": 1,
      "defaultDimension": "2*2",
      "supportDimensions": ["2*2"],
      "supportDeviceTypes": ["phone"],
      "standby": {
        "isSupported": true,
        "isAdapted": true,
        "isPrivacySensitive": false
      }
    }
  ]
}
