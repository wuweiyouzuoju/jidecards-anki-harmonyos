// ========================================================
// @块ID UTIL-SETTINGS-COLORS-001
// @名称 设置面板共享色板
//
// @作用
// 集中托管设置面板的 11 项配色（背景、文本层级、分隔线、标签背景、
// 主色、主色按钮背景、错误色、遮罩等），按 isDark 一次性生成色板。
// 把原 设置面板组件 中 11 个 isDark 三元颜色判断合并为一张表。
// 子组件只需 @Prop isDark + 调 设置面板色板_取(isDark) 即可拿到全部颜色。
//
// @输入
// 是否深色模式（isDark）。
//
// @输出
// 设置面板色板 对象（11 个字段）。
//
// @业务规则
// 主色 字段从 AppStorage 读取（颜色键.动作主色），跟随用户选择的颜色主题：
//   主色 用于 chip 选中态背景——只有当前选中的 chip 被主题色实心包裹。
// 标签背景 用中性浅灰（不跟随主题色），让未选中 chip 在所有主题下视觉一致：
//   避免选绿时其他 chip 变浅绿、选蓝紫时其他 chip 因饱和度被减到 0 变白色看不出包裹的问题。
// 按钮背景专用主色（配 #FFFFFF 文字 ≥ 4.5:1）—— 2.1.4.1 深色模式修复。
// AppStorage 未就绪时回退到极光蓝兜底值。
// 深色/浅色模式下 三级文字 / 弱化文字 配 标签背景 需 ≥4.5:1
// （2.1.4.1 对比度修复，用于 同步分组 placeholder / 语音分组 状态标签）。
//
// @副作用
// 通过 AppStorage.get 读取全局主题色（只读，无写入）。
//
// @注意
// 修改颜色值前请先核对 WCAG ≥4.5:1 对比度（配 标签背景）。
// 兜底主色 / 兜底主色按钮背景 仅在 AppStorage 未就绪时使用。
// ========================================================

import { 颜色键 } from '../model/颜色主题';
import { SurfaceBorder } from './SurfaceBorder';
import { 规范化主题模式, 解析是否深色 } from '../model/主题设置';

/**
 * 设置面板共享色板：背景 / 主文字 / 次文字 / 三级文字 / 弱化文字 /
 * 分隔线 / 标签背景 / 主色 / 主色按钮背景 / 错误色 / 遮罩。
 */
export interface 设置面板色板 {
  背景: string;
  主文字: string;
  次文字: string;
  三级文字: string;
  弱化文字: string;
  分隔线: ResourceColor;
  标签背景: string;
  主色: string;
  /** 按钮背景专用主色（配 #FFFFFF 文字 ≥ 4.5:1）。2.1.4.1 深色模式修复。 */
  主色按钮背景: string;
  错误色: string;
  遮罩: string;
  /** 输入框背景色（TextInput/TextArea 用） */
  输入框背景: string;
}

// ========================================================
// @块ID UTIL-SETTINGS-COLORS-002
// @名称 兜底主色
//
// @作用
// 返回默认主色（极光蓝）作为 AppStorage 未就绪时的兜底。
//
// @输入
// 是否深色模式
//
// @输出
// 兜底主色色值字符串。
//
// @业务规则
// 深色：#5C84E6；浅色：#2F5FD0。
//
// @副作用
// 无。
// ========================================================

/** 默认主色（极光蓝）作为 AppStorage 未就绪时的兜底。 */
function 兜底主色(是否深色: boolean): string {
  return 是否深色 ? '#5C84E6' : '#2F5FD0';
}

// ========================================================
// @块ID UTIL-SETTINGS-COLORS-003
// @名称 兜底主色按钮背景
//
// @作用
// 返回默认按钮背景主色兜底（极光蓝 shade 6，配白字 5.7:1）。
//
// @输入
// 是否深色模式
//
// @输出
// 兜底主色按钮背景色值字符串。
//
// @业务规则
// 深色/浅色均为 #2F5FD0。
//
// @副作用
// 无。
// ========================================================

/** 默认按钮背景主色兜底（极光蓝 shade 6，配白字 5.7:1）。 */
function 兜底主色按钮背景(是否深色: boolean): string {
  return 是否深色 ? '#2F5FD0' : '#2F5FD0';
}

// ========================================================
// @块ID UTIL-SETTINGS-COLORS-004
// @名称 中性标签背景
//
// @作用
// 返回 chip 中性背景：浅灰 / 深灰，不跟随主题色。
// 未选中 chip 在所有主题下视觉一致。
//
// @输入
// 是否深色模式
//
// @输出
// 中性标签背景色值字符串。
//
// @业务规则
// 深色：#334155；浅色：#F1F5F9。
//
// @副作用
// 无。
// ========================================================

/** chip 中性背景：浅灰/深灰，不跟随主题色。未选中 chip 在所有主题下视觉一致。 */
function 中性标签背景(是否深色: boolean): string {
  return 是否深色 ? '#334155' : '#F1F5F9';
}

// ========================================================
// @块ID UTIL-SETTINGS-COLORS-005
// @名称 解析主色
//
// @作用
// 从 AppStorage 读当前主题色 动作主色；未就绪时回退到极光蓝。
//
// @输入
// 是否深色模式
//
// @输出
// 主色色值字符串。
//
// @业务规则
// 优先用 AppStorage.get(颜色键.动作主色)；为空 / undefined 时用 兜底主色。
//
// @副作用
// 只读 AppStorage，无写入。
// ========================================================

/** 从 AppStorage 读当前主题色 动作主色；未就绪时回退到极光蓝。 */
function 解析主色(是否深色: boolean): string {
  const 存储: string | undefined = AppStorage.get<string>(颜色键.动作主色);
  return 存储 !== undefined && 存储 !== '' ? 存储 : 兜底主色(是否深色);
}

// ========================================================
// @块ID UTIL-SETTINGS-COLORS-006
// @名称 解析主色按钮背景
//
// @作用
// 从 AppStorage 读按钮背景专用主色 主色按钮背景；未就绪时回退到极光蓝 shade 6。
//
// @输入
// 是否深色模式
//
// @输出
// 主色按钮背景色值字符串。
//
// @业务规则
// 优先用 AppStorage.get(颜色键.主色按钮背景)；为空 / undefined 时用 兜底主色按钮背景。
//
// @副作用
// 只读 AppStorage，无写入。
// ========================================================

/** 从 AppStorage 读按钮背景专用主色 主色按钮背景；未就绪时回退到极光蓝 shade 6。 */
function 解析主色按钮背景(是否深色: boolean): string {
  const 存储: string | undefined = AppStorage.get<string>(颜色键.主色按钮背景);
  return 存储 !== undefined && 存储 !== '' ? 存储 : 兜底主色按钮背景(是否深色);
}

// ========================================================
// @块ID UTIL-SETTINGS-COLORS-007
// @名称 解析标签背景
//
// @作用
// chip 中性背景（不读 AppStorage）：未选中 chip 不跟随主题色，
// 只有选中 chip 用 主色 包裹。
//
// @输入
// 是否深色模式
//
// @输出
// 标签背景色值字符串。
//
// @业务规则
// 委托 中性标签背景 返回值（浅灰 / 深灰）。
//
// @副作用
// 无。
// ========================================================

/** chip 中性背景（不读 AppStorage）：未选中 chip 不跟随主题色，只有选中 chip 用 主色 包裹。 */
function 解析标签背景(是否深色: boolean): string {
  return 中性标签背景(是否深色);
}

// ========================================================
// @块ID UTIL-SETTINGS-COLORS-010
// @名称 解析同步是否深色
//
// @作用
// 从 AppStorage 同步读取 'themeMode' + 'systemDarkMode' 计算当前是否深色，
// 确保 设置面板色板_取 内的硬编码颜色（主文字/背景等）与 @StorageLink 颜色键
// （主色/主色按钮背景）在同一帧内保持一致。
//
// @输入
// 回退值: boolean — AppStorage 未就绪时（如测试环境/首帧前）的兜底值。
//
// @输出
// 当前是否深色模式。
//
// @业务规则
// B12-Y5 2026-07-29 修复 Bug 1（颜色主题切换后字亮度不一致）：
// 主题模式切换时，首页.应用激活主题 先写 'themeMode' 到 AppStorage，
// 再调 应用颜色主题 写颜色键。@StorageLink 组件因颜色键变化触发重渲染时，
// @Prop 是否深色 尚未从父组件传播下来（仍为旧值），但 AppStorage 中 'themeMode'
// 已更新为新值。此时若 设置面板色板_取 用旧 @Prop 取硬编码颜色，
// 主色（@StorageLink 新值）与主文字（硬编码旧值）会出现明暗不一致。
// 改为从 AppStorage 同步读取后，两者在同一帧内一致。
//
// @副作用
// 只读 AppStorage，无写入。
// ========================================================

/** 从 AppStorage 同步读取是否深色；未就绪时回退到参数。 */
function 解析同步是否深色(回退值: boolean): boolean {
  const 模式字符串: string | undefined = AppStorage.get<string>('themeMode');
  const 系统深色: boolean | undefined = AppStorage.get<boolean>('systemDarkMode');
  if (模式字符串 === undefined || 系统深色 === undefined) {
    return 回退值;
  }
  return 解析是否深色(规范化主题模式(模式字符串), 系统深色);
}

// ========================================================
// @块ID UTIL-SETTINGS-COLORS-008
// @名称 按深色模式生成色板
//
// @作用
// 按 isDark 一次性生成 设置面板色板；调用方缓存到本地 const 即可。
//
// @输入
// 回退是否深色: boolean — AppStorage 未就绪时的兜底值（通常传 @Prop 是否深色）。
//
// @输出
// 设置面板色板 对象（11 个字段）。
//
// @业务规则
// 是否深色 优先从 AppStorage 同步读取（'themeMode' + 'systemDarkMode'），
// 确保与 @StorageLink 颜色键（主色/主色按钮背景）在同一帧内一致；
// AppStorage 未就绪时回退到参数。
// 深色模式：
//   背景 #1E293B，主文字 #F1F5F9，次文字 #CBD5E1，
//   三级文字 #AEBBCE（配 标签背景 #334155 ≥4.5:1，5.33:1），
//   弱化文字 #9FB3CC（4.83:1），
//   分隔线 #334155，
//   标签背景 = 解析标签背景，主色 = 解析主色，主色按钮背景 = 解析主色按钮背景，
//   错误色 #F87171，遮罩 rgba(0,0,0,0.40)。
// 浅色模式：
//   背景 #FFFFFF，主文字 #182230，次文字 #475569，
//   三级文字 #616A78（配 标签背景 #F1F5F9 ≥4.5:1，4.99:1），
//   弱化文字 #656E7C（4.70:1），
//   分隔线 #F1F5F9，
//   标签背景 = 解析标签背景，主色 = 解析主色，主色按钮背景 = 解析主色按钮背景，
//   错误色 #DC2626，遮罩 rgba(0,0,0,0.15)。
// 三级文字 / 弱化文字 在 2.1.4.1 调整对比度（原值配 标签背景 仅 4.04/3.22:1 不达标）。
//
// @副作用
// 通过 解析同步是否深色 / 解析主色 / 解析主色按钮背景 间接读取 AppStorage。
// ========================================================

/** 按 isDark 一次性生成色板；调用方缓存到本地 const 即可。 */
export function 设置面板色板_取(回退是否深色: boolean): 设置面板色板 {
  const 是否深色: boolean = 解析同步是否深色(回退是否深色);
  return 是否深色 ? {
    背景: '#1E293B',
    主文字: '#F1F5F9',
    次文字: '#CBD5E1',
    // 2.1.4.1 深色对比度：配 标签背景 #334155 需 ≥4.5:1。
    // 三级文字 #94A3B8→#AEBBCE（5.33:1 vs 标签背景），弱化文字 #7D91AE→#9FB3CC（4.83:1 vs 标签背景）。
    // 原值配 标签背景 仅 4.04/3.22:1，用于 同步分组 placeholder / 语音分组 状态标签时不达标。
    三级文字: '#AEBBCE',
    弱化文字: '#9FB3CC',
    分隔线: SurfaceBorder.color(),
    标签背景: 解析标签背景(是否深色),
    主色: 解析主色(是否深色),
    主色按钮背景: 解析主色按钮背景(是否深色),
    错误色: '#F87171',
    输入框背景: '#1E293B',
    遮罩: 'rgba(0,0,0,0.40)'
  } : {
    背景: '#FFFFFF',
    主文字: '#182230',
    次文字: '#475569',
    // 2.1.4.1 浅色对比度：配 标签背景 #F1F5F9 需 ≥4.5:1。
    // 三级文字 #64748B→#616A78（4.99:1 vs 标签背景），弱化文字 #687281→#656E7C（4.70:1 vs 标签背景）。
    // 原值配 标签背景 仅 4.35/4.45:1，用于 同步分组 placeholder / 语音分组 状态标签时不达标。
    三级文字: '#616A78',
    弱化文字: '#656E7C',
    分隔线: SurfaceBorder.color(),
    标签背景: 解析标签背景(是否深色),
    主色: 解析主色(是否深色),
    主色按钮背景: 解析主色按钮背景(是否深色),
    错误色: '#DC2626',
    输入框背景: '#F1F5F9',
    遮罩: 'rgba(0,0,0,0.15)'
  };
}

// ========================================================
// @块ID UTIL-SETTINGS-COLORS-009
// @名称 标签文字色
//
// @作用
// chip 文本色：选中白字，未选中跟随次级文本色。
//
// @输入
// 色板     已生成的 设置面板色板
// 是否选中 chip 是否处于选中态
//
// @输出
// chip 文本色字符串。
//
// @业务规则
// 选中 → #FFFFFF；未选中 → 色板.次文字。
//
// @副作用
// 无。
// ========================================================

/** chip 文本色：选中白字，未选中跟随次级文本色。 */
export function 标签文字色(色板: 设置面板色板, 是否选中: boolean): string {
  return 是否选中 ? '#FFFFFF' : 色板.次文字;
}
