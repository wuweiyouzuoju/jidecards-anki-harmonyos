/** 设置的语义图标入口；同义动作复用首页/学习已有资源。 */
export function settingsIcon(id: string): Resource {
  switch (id) {
    case 'home_today_summary':
      return $r('app.media.ic_home_stats');
    case 'general':
    case 'general_display':
      return $r('app.media.ic_settings_general');
    case 'scheduler':
    case 'global_review':
      return $r('app.media.ic_settings_review');
    case 'appearance':
    case 'color_theme':
      return $r('app.media.ic_settings_appearance');
    case 'data':
      return $r('app.media.ic_settings_data');
    case 'help':
    case 'anki_documentation':
      return $r('app.media.ic_settings_help');
    case 'redemption':
      return $r('app.media.ic_settings_redemption');
    case 'about':
    case 'help_browser_info':
      return $r('app.media.ic_settings_about');
    case 'advanced':
      return $r('app.media.ic_settings_advanced');
    case 'sync':
    case 'auto_sync':
      return $r('app.media.ic_home_sync');
    case 'ai':
      return $r('app.media.ic_study_agent');
    case 'import':
    case 'restore_collection':
      return $r('app.media.ic_home_import');
    case 'export_deck':
    case 'export_collection':
      return $r('app.media.ic_settings_export');
    case 'backups':
    case 'sync_backup_first':
      return $r('app.media.ic_settings_backup');
    case 'notetypes':
    case 'help_siblings':
      return $r('app.media.ic_settings_notetypes');
    case 'hidden_decks':
      return $r('app.media.ic_settings_hidden');
    case 'media_management':
    case 'sync_media':
    case 'ai_vision':
      return $r('app.media.ic_settings_media');
    case 'check_database':
      return $r('app.media.ic_settings_check');
    case 'empty_cards':
      return $r('app.media.ic_settings_empty');
    case 'duplicate_notes':
      return $r('app.media.ic_settings_duplicates');
    case 'unused_tags':
      return $r('app.media.ic_settings_tags');
    case 'feedback':
      return $r('app.media.ic_settings_feedback');
    case 'rate':
      return $r('app.media.ic_settings_rate');
    case 'community':
      return $r('app.media.ic_settings_community');
    case 'licenses':
      return $r('app.media.ic_settings_licenses');
    case 'ankiweb':
    case 'ai_web_enabled':
      return $r('app.media.ic_settings_web');
    case 'ai_web_provider':
      return $r('app.media.ic_settings_search');
    case 'language':
      return $r('app.media.ic_settings_language');
    case 'study_haptics':
      return $r('app.media.ic_settings_haptics');
    case 'review_controls':
    case 'study_quick_answer':
      return $r('app.media.ic_settings_touch');
    case 'study_layout':
    case 'deck_list_style':
    case 'help_sidebar':
      return $r('app.media.ic_settings_layout');
    case 'card_text_size':
      return $r('app.media.ic_settings_font');
    case 'study_display':
    case 'show_remaining':
    case 'ai_batch_limit':
      return $r('app.media.ic_settings_remaining');
    case 'show_intervals':
      return $r('app.media.ic_settings_interval');
    case 'help_bury':
      return $r('app.media.ic_study_bury');
    case 'help_suspend':
      return $r('app.media.ic_study_suspend');
    case 'help_delete':
      return $r('app.media.ic_study_delete');
    case 'help_undo':
      return $r('app.media.ic_study_undo');
    case 'help_shortcuts':
      return $r('app.media.ic_settings_keyboard');
    case 'help_find_replace':
      return $r('app.media.ic_settings_find_replace');
    case 'algorithm':
      return $r('app.media.ic_settings_fsrs');
    case 'fsrs_enabled':
      return $r('app.media.ic_settings_fsrs');
    case 'help_fsrs':
      return $r('app.media.ic_settings_fsrs');
    case 'help_fuzz':
      return $r('app.media.ic_settings_fuzz');
    case 'help_rating':
      return $r('app.media.ic_settings_rating_controls');
    case 'theme_mode':
      return $r('app.media.ic_settings_theme_mode');
    case 'theme_motion':
      return $r('app.media.ic_settings_motion');
    case 'help_batch':
      return $r('app.media.ic_settings_batch');
    case 'rollover':
      return $r('app.media.ic_settings_rollover');
    case 'learn_ahead':
      return $r('app.media.ic_settings_learn_ahead');
    case 'timebox':
      return $r('app.media.ic_settings_timebox');
    case 'help_lapse':
      return $r('app.media.ic_settings_lapse');
    case 'help_leech':
      return $r('app.media.ic_settings_leech');
    case 'note_field':
      return $r('app.media.ic_settings_field');
    case 'help_graduate':
      return $r('app.media.ic_settings_graduate');
    default:
      return $r('app.media.ic_info');
  }
}
